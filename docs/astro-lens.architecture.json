  "cards": [
    {
      "dot": "cyan",
      "title": "The chart is not AI",
      "items": [
        "iztro computes all 12 palaces locally",
        "Always generated in vi-VN, so the Vietnamese term is the join key for every other locale",
        "Switching language never regenerates a chart"
      ]
    },
    {
      "dot": "emerald",
      "title": "The reading is",
      "items": [
        "One prompt pack per locale drives instruction, output language and vocabulary",
        "Every judgement cites the cung and sao behind it",
        "npm run eval checks what the model said against the chart it was given"
      ]
    },
    {
      "dot": "amber",
      "title": "Two traps worth knowing",
      "items": [
        "The context cache is found by displayName only — editing the system instruction while a cache exists does nothing",
        "Export re-renders onto the paper variant; a dark PDF is an unreadable printed document"
      ]
    }
